{% extends 'base.html.twig' %}

{% block title %}Interventions{% endblock %}

{% block body %}
<div class="m-3">
    <h1>Liste des interventions</h1>
</div>

<a href="{{path('app_interventions_new')}}" class="btn btn-primary m-3 mx-3">Nouvelle intervention</a>


{# Bootsrap à améliorer #}
<div class="row">
    <div class="col-11 mx-auto">
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Date de début</th>
                            <th>Date de fin</th>
                            <th>Description</th>
                            <th>Plombier</th>
                            <th>Client</th>
                            <th>Statut</th>
                            <th>Durée</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for intervention in interventions %}
                        <tr>
                            <td>{{ intervention.type.value }}</td>
                            <td>{{ intervention.startAt ? intervention.startAt|date('Y-m-d H:i:s') : 'N/A' }}</td>
                            <td>{{ intervention.endAt ? intervention.endAt|date('Y-m-d H:i:s') : 'N/A' }}</td>
                            <td>{{ intervention.description }}</td>
                            <td>
                                {% if intervention.fkEmployee %}
                                {{ intervention.fkEmployee.fullName }}
                                {% else %}
                                <span class="badge bg-warning text-dark">Non assigné</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if intervention.fkClient %}
                                {{ intervention.fkClient.fullName }}
                                {% else %}
                                <span class="badge bg-secondary">Inconnu</span>
                                {% endif %}
                            </td>
                            <td>
                                {% set statusColors = {
                                'to_plan': 'bg-warning text-dark',
                                'planned': 'bg-primary',
                                'ongoing': 'bg-info text-dark',
                                'finished': 'bg-success',
                                'canceled': 'bg-danger'
                                } %}
                                <span class="badge {{ statusColors[intervention.status.value] ?? 'bg-secondary' }}">
                                    {{ intervention.status.label()|trans }}
                                </span>
                            </td>
                            <td>
                                <a class="btn btn-primary m-1"
                                    href="{{ path('app_interventions_show', {'id': intervention.id}) }}">Détails</a>
                                <a class="btn btn-primary m-1"
                                    href="{{ path('app_interventions_edit', {'id': intervention.id}) }}">Modifier</a>
                                <a class="btn btn-primary m-1"
                                    href="{{ path('app_used_pieces_use_piece', {'id': intervention.id}) }}">Utiliser du
                                    matériel</a>
                                {% if intervention.status.value == 'to_plan' %}
                                <a class="btn btn-success m-1"
                                    href="{{ path('app_interventions_assign', {'id': intervention.id}) }}">Attribuer</a>
                                {% endif %}
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6">Aucune intervention trouvée</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{% endblock %}
