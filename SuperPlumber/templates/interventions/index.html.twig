{% extends 'base.html.twig' %}

{% block title %}Interventions{% endblock %}

{% block body %}
<div class="m-3">
    <h1>Liste des interventions</h1>
</div>

<a href="{{path('app_interventions_new')}}" class="btn btn-primary m-3 mx-3">Nouvelle intervention</a>

{% embed "/fragments/_interventions_table.html.twig" with { interventions: interventions } %}

{% block table_headers_common %}
{{ parent() }}
{% endblock %}

{% block table_headers_custom %}
{{ parent() }}
<th style="width:80px">Durée</th>
<th>Client</th>
<th>Plombier</th>
{% endblock %}

{% block table_headers_after %}
{{ parent() }}
{% endblock %}


{% block table_columns_common %}
{{ parent() }}
{% endblock %}

{% block table_columns_custom %}
{{ parent() }}
<td>{{ intervention.getDurationFormatted ?? 'N/A' }} </td>
<td>
    {% if intervention.fkClient %}
    {{ intervention.fkClient.fullName }}
    {% else %}
    <span class="badge bg-secondary">Inconnu</span>
    {% endif %}
</td>
<td>
    {% if intervention.fkEmployee %}
    {{ intervention.fkEmployee.fullName }}
    {% else %}
    <span class="badge bg-warning text-dark">Non assigné</span>
    {% endif %}
</td>
{% endblock %}

{% block table_columns_after %}
{{ parent() }}
{# Actions #}
<td>
    <div class="d-flex gap-1">
        <a class="btn btn-primary" href="{{ path('app_interventions_show', {'id': intervention.id}) }}">Détails</a>
        <a class="btn btn-primary" href="{{ path('app_interventions_edit', {'id': intervention.id}) }}">Modifier</a>
    </div class="d-flex gap-1">
    <a class="btn btn-primary m-1" href="{{ path('app_used_pieces_use_piece', {'id': intervention.id}) }}">Utiliser
        matériel</a>
    {% if intervention.status.value == 'to_plan' %}
    <a class="btn btn-success m-1" href="{{ path('app_interventions_assign', {'id': intervention.id}) }}">Attribuer</a>
    {% endif %}
</td>
{% endblock %}
{% endembed %}

{% endblock %}