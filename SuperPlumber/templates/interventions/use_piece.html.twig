{% extends 'base.html.twig' %}

{% block title %}Utiliser du matériel{% endblock %}

{% block body %}
<div class="container mt-4">

    <div class="row">

        {# --- Colonne gauche : Matériel utilisé --- #}
        <div class="col-md-6">
            <h3 class="mb-3">Matériel déjà utilisé</h3>

            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Nom</th>
                                <th>Quantité</th>
                                <th>Est consommé</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for usedPiece in usedPieces %}
                            <tr>
                                <td>{{ usedPiece.fkPiece.name}}</td>
                                <td>{{ usedPiece.quantity}}</td>
                                <td>{{ usedPiece.isConsumable == 1 ? 'oui' : 'non' }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# --- Colonne droite : Utiliser du matériel --- #}
        <div class="col-md-6">
            <h3 class="mb-3">Utiliser du matériel</h3>
            <form method="post" action="{{ path('app_used_pieces_form_submitted', { id : intervention.id}) }}">
             <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Nom</th>
                                <th>Quantité en stock</th>
                                <th>Quantité à utiliser</th>
                                <th>Est consommable ?</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for piece in pieces %}
                            <tr>
                                <td>{{ piece.name }}</td>
                                <td>{{ piece.quantity }}</td>
                                <td>
                                    <input type="number" class="form-control quantity-input" name="quantity_{{piece.id}}" min="0" max="{{piece.quantity}}" >
                                </td>
                                <td>
                                    <label>Est consommable ? : </label>
                                    <input type="checkbox" class="form-check-input" name="isConsumable_{{piece.id}}" value="1">
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="mt-3 text-end">
                     <button type="submit" class="btn btn-primary">
                       Enregistrer le matériel utilisé
                     </button>
                 </div>
            </form>
            </div>
        </div>

    </div>

</div>
{% endblock %}
