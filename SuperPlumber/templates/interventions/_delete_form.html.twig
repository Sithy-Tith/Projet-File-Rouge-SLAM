<form method="post" action="{{ path('app_interventions_delete', {'id': intervention.id}) }}"
    onsubmit="return confirm('Êtes-vous sûrs de vouloirs supprimer ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ intervention.id) }}">
    <button class="btn btn-danger m-2">Supprimer</button>
</form>