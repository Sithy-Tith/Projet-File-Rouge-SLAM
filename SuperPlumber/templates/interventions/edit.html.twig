{% extends 'base.html.twig' %}

{% block title %}Éditer l'intervention{% endblock %}

{% block body %}
<div class="m-3">
    <h1>Éditer l'intervention</h1>
</div>

<div class="container-fluid">
    <div class="card col-8 mx-3">
        <div class="m-3">
            {{ include('interventions/_form.html.twig', {'button_label': 'Enregistrer'}) }}
        </div>
