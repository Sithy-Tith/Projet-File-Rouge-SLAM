{% extends 'base.html.twig' %}

{% block title %}Interventions{% endblock %}

{% block body %}
    <h1>Interventions</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ intervention.id }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ intervention.date ? intervention.date|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ intervention.description }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ intervention.status }}</td>
            </tr>
            <tr>
                <th>Duration</th>
                <td>{{ intervention.duration }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_interventions_index') }}">back to list</a>

    <a href="{{ path('app_interventions_edit', {'id': intervention.id}) }}">edit</a>

    {{ include('interventions/_delete_form.html.twig') }}
{% endblock %}
