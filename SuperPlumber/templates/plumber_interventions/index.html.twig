{% extends 'base.html.twig' %}

{% block title %}>Mes interventions{% endblock %}

{% block body %}

{% embed "/fragments/_interventions_table.html.twig" with { interventions: interventions } %}

{% block table_headers_common %}
{{ parent() }}
{% endblock %}

{% block table_headers_custom %}
{{ parent() }}
<th>Durée estimée</th>
<th>Client</th>
{% endblock %}

{% block table_headers_after %}
{{ parent() }}
{% endblock %}


{% block table_columns_common %}
{{ parent() }}
{% endblock %}

{% block table_columns_custom %}
{{ parent() }}
{% set start = intervention.startAt|date('U') %}
{% set end = intervention.endAt|date('U') %}

<td>{{ ((end - start) // 3600) }}h {{((end-start)/60)%60}} </td>
<td> {{ intervention.fkClient.getFullName }} </td>
{% endblock %}

{% block table_columns_after %}
{{ parent() }}
<td>
    {# Avoir les bons paths avec les bons droits avant de décommenter pour ajouter ces actions :
    <a href="{{ path('app_interventions_show', {'id': intervention.id}) }}" class="btn btn-info m-1">Détails</a>
    <a href="{{ path('app_interventions_edit', {'id': intervention.id}) }}" class="btn btn-info m-1">Mettre à jour</a>
    #}
    <div class="card">
        <p>Voir plumber_interventions/index.html pour plus d'actions</p>
    </div>
    <a href="{{ path('app_used_pieces_use_piece', {'id': intervention.id}) }}" class="btn btn-info m-1">Utiliser du
        matériel</a>
</td>
{% endblock %}
{% endembed %}


{% endblock %}
