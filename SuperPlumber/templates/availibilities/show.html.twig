{% extends 'base.html.twig' %}

{% block title %}Availibilities{% endblock %}

{% block body %}
    <h1>Availibilities</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ availibility.id }}</td>
            </tr>
            <tr>
                <th>Availibility</th>
