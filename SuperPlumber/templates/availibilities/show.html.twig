    </table>

    <a href="{{ path('app_availibilities_index') }}">back to list</a>

    <a href="{{ path('app_availibilities_edit', {'id': availibility.id}) }}">edit</a>

    {{ include('availibilities/_delete_form.html.twig') }}
{% endblock %}
