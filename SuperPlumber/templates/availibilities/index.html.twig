{% extends 'base.html.twig' %}

{% block title %}Availibilities index{% endblock %}

{% block body %}
    <h1>Availibilities index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Availibility</th>
                <th>Date</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for availibility in availibilities %}
            <tr>
                <td>{{ availibility.id }}</td>
                <td>{{ availibility.availibility }}</td>
                <td>{{ availibility.date ? availibility.date|date('Y-m-d') : '' }}</td>
                <td>
                    <a href="{{ path('app_availibilities_show', {'id': availibility.id}) }}">show</a>
                    <a href="{{ path('app_availibilities_edit', {'id': availibility.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_availibilities_new') }}">Create new</a>
{% endblock %}
