{% extends 'base.html.twig' %}

{% block title %}Éditer {{ employee.getFullName() }}{% endblock %}

{% block body %}
<div class="m-3">
    <h1>Éditer {{ employee.getFullName() }}</h1>
</div>

<div class="container-fluid">
    <div class="card col-8 mx-3">
        <div class="m-3">
            {{ include('employees/_form.html.twig', {'button_label': 'Enregistrer'}) }}
        </div>
        <div class="mx-2">
            <a href="{{ path('app_employees_index') }}" class="btn btn-primary m-2">Retour à la liste</a>
            {{ include('employees/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}