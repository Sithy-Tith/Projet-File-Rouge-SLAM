<form method="post" action="{{ path('app_employees_delete', {'id': employee.id}) }}"
    onsubmit="return confirm('Êtes-vous sûrs de vouloirs supprimer ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ employee.id) }}">
    <button class="btn btn-danger m-2">Supprimer</button>
</form>