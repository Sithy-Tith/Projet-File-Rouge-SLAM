{% extends 'base.html.twig' %}

{% block title %}Employé{% endblock %}

{% block body %}
<h1>{{ employee.getFullName() }}</h1>

<table class="table">
    <tbody>
        <tr>
            <th>NOM Prénom</th>
            <td>{{ employee.getFullName() }}</td>
        </tr>
        <tr>
            <th>Poste</th>
            <td>{{ employee.position.value }}</td>
        </tr>
        <tr>
            <th>Email</th>
            <td>{{ employee.email }}</td>
        </tr>
        <tr>
            <th>Téléphone</th>
            <td>{{ employee.phone }}</td>
        </tr>
    </tbody>
</table>

<a href="{{ path('app_employees_index') }}">Retour à la liste</a>

<a href="{{ path('app_employees__edit', {'id': employee.id}) }}">edit</a>

{{ include('employees/_delete_form.html.twig') }}
{% endblock %}