{% extends 'base.html.twig' %}

{% block title %}Employé{% endblock %}

{% block body %}
<div class="m-3">
    <h1>{{ employee.getFullName() }}</h1>
</div>

<div class="container-fluid">
    <div class="card shadow-sm col-7">
        <table class="table">
            <tbody>
                <tr>
                    <th>NOM Prénom</th>
                    <td>{{ employee.getFullName() }}</td>
                </tr>
                <tr>
                    <th>Poste</th>
                    <td>{{ employee.position.label()|trans }}</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>{{ employee.email }}</td>
                </tr>
                <tr>
                    <th>Téléphone</th>
                    <td>{{ employee.phone }}</td>
                </tr>
            </tbody>
        </table>
        <div class="row">
            <div class=" m-2">
                {% if is_granted('ROLE_ADMIN') %}
                    <a class="btn btn-primary" href="{{ path('app_employees_index') }}">Retour à la liste</a>
                    <a class="btn btn-primary" href="{{ path('app_employees_edit', {'id': employee.id}) }}">Éditer</a>
                    {{ include('employees/_delete_form.html.twig') }}
                {% elseif is_granted('ROLE_PLUMBER') %}
                    <a class="btn btn-primary" href="{{ path('app_employees_profile_edit', {'id': employee.id}) }}">Éditer</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
