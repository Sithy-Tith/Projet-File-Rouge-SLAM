{% extends 'base.html.twig' %}

{% block title %}Employees index{% endblock %}

{% block body %}
    <h1>Employees index</h1>

    <form action="{{path('app_employees_index')}}" method="get">
        <div class="row col-3 mt-5">
            <div class="input-group">
                <input type="text"
                    class="form-control"
                    name="search"
                    placeholder="{{ term|default('Rechercher un employé ...') }}"> {#Affiche le text recherché ou un message par défaut sinon#}
                <button class="btn btn-primary" type="submit">Rechercher</button>
            </div>
        </div>
    </form>

    {% if isSearch %}
        <a href="{{path('app_employees_index')}}" class="btn btn-secondary my-3"> Retour à la liste</a>
    {% endif %}

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Password</th>
                <th>LastName</th>
                <th>FirstName</th>
                <th>Phone</th>
                <th>Position</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for employee in employees %}
            <tr>
                <td>{{ employee.id }}</td>
                <td>{{ employee.email }}</td>
                <td>{{ employee.roles ? employee.roles|json_encode : '' }}</td>
                <td>{{ employee.password }}</td>
                <td>{{ employee.lastName }}</td>
                <td>{{ employee.firstName }}</td>
                <td>{{ employee.phone }}</td>
                <td>{{ employee.position.value }}</td>
                <td>
                    <a href="{{ path('app_employees_show', {'id': employee.id}) }}">show</a>
                    <a href="{{ path('app_employees_edit', {'id': employee.id}) }}">edit</a>
                {% if is_granted("ROLE_ADMIN") %}
                    <a href="{{ path('app_employees_index', { '_switch_user': employee.email }) }}">Impersonate</a>
                {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_employees_new') }}">Create new</a>
{% endblock %}
