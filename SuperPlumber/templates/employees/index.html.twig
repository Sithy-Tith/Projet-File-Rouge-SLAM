{% extends 'base.html.twig' %}

{% block title %}Employés{% endblock %}

{% block body %}
<div class="m-3">
    <h1>Liste des employés</h1>
</div>

<div>
    <form action="{{path('app_employees_index')}}" method="get">
        <div class="row col-4 m-2">
            <div class="input-group">
                <input type="text" class="form-control" name="search"
                    placeholder="{{ term|default('Rechercher un employé ...') }}"> {#Affiche le text recherché ou un
                message par défaut sinon#}
                <button class="btn btn-primary" type="submit">Rechercher</button>
                {% if isSearch %}
                <a href="{{path('app_employees_index')}}" class="btn btn-secondary">Réinitialiser</a>
                {% endif %}
            </div>
        </div>
    </form>
</div>


<a href="{{path('app_employees_new')}}" class="btn btn-primary m-2 mx-3">Ajouter un nouveau employé</a>

{# Bootsrap à améliorer #}
<div class="row">
    <div class="col-11 mx-auto">
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Poste</th>
                            <th>Email</th>
                            <th>Téléphone</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for employee in employees %}
                        <tr>
                            <td>{{ employee.getFullName() }}</td>
                            <td>{{ employee.position.label()|trans }}</td>
                            <td>{{ employee.email }}</td>
                            <td>{{ employee.phone }}</td>
                            <td>
                                <a class="btn btn-primary" href="{{ path('app_employees_show', {'id': employee.id})}}">
                                    Détails</a>
                                <a class="btn btn-primary" href="{{ path('app_employees_edit', {'id': employee.id}) }}">
                                    Modifier</a>
                                {% if is_granted("ROLE_ADMIN") %}
                                <a class="btn btn-primary"
                                    href="{{ path('app_plumber_dashboard', { '_switch_user': employee.email }) }}">
                                    Switch</a>
                                {% endif %}
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td>Aucun employé trouvé</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{% endblock %}