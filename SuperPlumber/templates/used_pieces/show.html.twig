{% extends 'base.html.twig' %}

{% block title %}UsedPieces{% endblock %}

{% block body %}
<h1>UsedPieces</h1>

<table class="table">
    <tbody>
        <tr>
            <th>Id</th>
            <td>{{ used_piece.id }}</td>
        </tr>
        <tr>
            <th>IsConsumable</th>
            <td>{{ used_piece.isConsumable ? 'Yes' : 'No' }}</td>
        </tr>
        <tr>
            <th>Quantity</th>
            <td>{{ used_piece.quantity }}</td>
        </tr>
    </tbody>
</table>

<a href="{{ path('app_used_pieces_index') }}" class="btn btn-primary m-2">Retour à la liste</a>

<a href="{{ path('app_used_pieces_edit', {'id': used_piece.id}) }}">edit</a>

{{ include('used_pieces/_delete_form.html.twig') }}
{% endblock %}