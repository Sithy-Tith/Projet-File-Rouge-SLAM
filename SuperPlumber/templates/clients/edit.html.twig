{% extends 'base.html.twig' %}

{% block title %}Éditer {{ client.getFullName() }}{% endblock %}

{% block body %}
<div class="m-3">
    <h1>Éditer {{ client.getFullName() }}</h1>
</div>

<div class="container-fluid">
    <div class="card col-8 mx-3">
        <div class="m-3">
            {{ include('clients/_form.html.twig', {'button_label': 'Enregistrer'}) }}
        </div>
        <div class="mx-2">
            {% if is_granted('ROLE_CLIENT') %}
                <a href="{{ path('app_clients_profile') }}" class="btn btn-secondary m-2">Annuler</a>
            {% elseif is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_clients_index') }}" class="btn btn-secondary m-2">Retour à la liste</a>
                {{ include('clients/_delete_form.html.twig') }}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
