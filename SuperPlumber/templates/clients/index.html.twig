{% extends 'base.html.twig' %}

{% block title %}
Liste des clients
{% endblock %}

{% block body %}
<div class="m-3">
    <h1>Liste des clients</h1>
</div>

<div>
    <form action="{{path('app_clients_index')}}" method="get">
        <div class="row col-4 m-2">
            <div class="input-group">
                <input type="text" class="form-control" name="search"
                    placeholder="{{ term|default('Rechercher un client ...') }}">
                {#Affiche le text recherché ou un message par défaut sinon#}
                <button class="btn btn-primary" type="submit">Rechercher</button>
                {% if isSearch %}
                <a href="{{path('app_clients_index')}}" class="btn btn-secondary">
                    Réinitialiser</a>
                {% endif %}
            </div>
        </div>
    </form>
</div>

<a href="{{ path('app_clients_new') }}" class="btn  btn-primary m-2 mx-3">Ajouter un nouveau client</a>

{# Bootsrap à améliorer #}
<div class="row">
    <div class="col-11 mx-auto">
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>NOM Prénom</th>
                            <th>Email</th>
                            <th>Téléphone</th>
                            <th>Adresse</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for client in clients %}
                        <tr>
                            <td>{{ client.getFullName() }}</td>
                            <td>{{ client.email }}</td>
                            <td>{{ client.phone }}</td>
                            <td>{{ client.address }}</td>
                            <td>
                                <a class="btn btn-primary"
                                    href="{{ path('app_clients_show', {'id': client.id}) }}">Détails</a>
                                <a class="btn btn-primary"
                                    href="{{ path('app_clients_edit', {'id': client.id}) }}">Éditer</a>
                                {% if is_granted("ROLE_ADMIN") %}
                                <span style="border-left: 1px solid #ccc; margin: 0 4px;"></span>
                                <a class="btn"
                                    href="{{ path('app_client_dashboard', {'_switch_user': client.email}) }}"
                                    style="background:#E8610A; color:white; padding: 6px 10px; transition: background-color 0.2s ease;"
                                    title="Switch sur ce compte"
                                    onmouseover="this.style.background='#c45208'; this.querySelector('img').style.transform='scale(1.2)'"
                                    onmouseout="this.style.background='#E8610A'; this.querySelector('img').style.transform='scale(1)'">
                                    <img src="{{ asset('icons/key-admin.svg') }}" alt="Switch"
                                        style="width: 18px; height: 18px; transition: transform 0.2s ease;">
                                </a>
                                {% endif %}
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td>Aucun Client trouvé</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
