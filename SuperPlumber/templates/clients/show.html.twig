{% extends 'base.html.twig' %}

{% block title %}Détails client
{% endblock %}

{% block body %}
<div class="m-3">
    <h1>{{ client.getFullName() }}</h1>
</div>

<div class="container-fluid">
    <div class="card shadow-sm col-7">
        <table class="table">
            <tbody>
                <tr>
                    <th>NOM Prénom</th>
                    <td>{{ client.getFullName() }}</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>{{ client.email }}</td>
                </tr>
                <tr>
                    <th>Téléphone</th>
                    <td>{{ client.phone }}</td>
                </tr>
                <tr>
                    <th>Adresse</th>
                    <td>{{ client.address }}</td>
                </tr>
            </tbody>
        </table>

        <div class="row">
            <div class=" m-2">
                {% if is_granted('ROLE_CLIENT') %}
                <a class="btn btn-primary" href="{{ path('app_clients_profile_edit') }}">Éditer</a>
                {% elseif is_granted('ROLE_ADMIN') %}
                <a class="btn btn-primary" href="{{ path('app_clients_index') }}">Retour à la liste</a>
                <a class="btn btn-primary" href="{{ path('app_clients_edit', {'id': client.id}) }}">Éditer</a>
                {{ include('clients/_delete_form.html.twig') }}
                {% endif %}
            </div>
        </div>
    </div>
</div>

{% endblock %}