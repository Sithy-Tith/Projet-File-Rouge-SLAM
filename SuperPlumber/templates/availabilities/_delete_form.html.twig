<form method="post" action="{{ path('app_availabilities_delete', {'id': availability.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ availability.id) }}">
    <button type="submit" class="btn btn-danger btn-sm">
    <i class="ti ti-trash"></i> Supprimer
    </button>
</form>
