<form method="post" action="{{ path('app_availabilities_delete', {'id': availability.id}) }}"
    onsubmit="return confirm('Êtes-vous sûrs de vouloirs supprimer ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ availability.id) }}">
    <button type="submit" class="btn btn-danger m-2">
        <i class="ti ti-trash"></i> Supprimer
    </button>
</form>