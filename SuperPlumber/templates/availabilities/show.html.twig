{% extends 'base.html.twig' %}

{% block title %}Availabilities{% endblock %}

{% block body %}
    <h1>Availabilities</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ availability.id }}</td>
            </tr>
            <tr>
                <th>Availability</th>
                <td>{{ availability.availability }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ availability.date ? availability.date|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_availabilities_index') }}">back to list</a>

    <a href="{{ path('app_availabilities_edit', {'id': availability.id}) }}">edit</a>

    {{ include('availabilities/_delete_form.html.twig') }}
{% endblock %}
