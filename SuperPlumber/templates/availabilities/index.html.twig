{% extends 'base.html.twig' %}

{% block title %}Availabilities index{% endblock %}

{% block body %}
    <h1>Availabilities index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Availability</th>
                <th>Date</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for availability in availabilities %}
            <tr>
                <td>{{ availability.id }}</td>
                <td>{{ availability.availability }}</td>
                <td>{{ availability.date ? availability.date|date('Y-m-d') : '' }}</td>
                <td>
                    <a href="{{ path('app_availabilities_show', {'id': availability.id}) }}">show</a>
                    <a href="{{ path('app_availabilities_edit', {'id': availability.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_availabilities_new') }}">Create new</a>
{% endblock %}
