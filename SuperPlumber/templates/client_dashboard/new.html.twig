{# templates/client/intervention_new.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Nouvelle demande d'intervention{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">Créer une demande d'intervention</h2>
                </div>
                <div class="card-body">
                    <p class="text-muted">Remplissez le formulaire ci-dessous pour qu'un plombier intervienne.</p>

                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_row(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Fuite sous évier'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.dateIntervention) }}
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">Envoyer la demande</button>
                            <a href="{{ path('app_client_dashboard') }}" class="btn btn-outline-secondary">Annuler</a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
