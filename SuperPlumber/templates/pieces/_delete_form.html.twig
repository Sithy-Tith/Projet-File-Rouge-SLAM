<form method="post" action="{{ path('app_pieces_delete', {'id': piece.id}) }}"
    onsubmit="return confirm('Êtes-vous sûrs de vouloirs supprimer ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ piece.id) }}">
    <button class="btn btn-danger m-2">Supprimer</button>
</form>