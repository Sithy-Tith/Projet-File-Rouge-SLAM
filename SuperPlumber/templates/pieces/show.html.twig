{% extends 'base.html.twig' %}

{% block title %}Inventaire{% endblock %}

{% block body %}

<div class="m-3">
    <h1>Inventaire : {{piece.name }}</h1>
</div>

<div class="container-fluid">
    <div class="card shadow-sm col-7">
        <table class="table">
            <tbody>
                <tr>
                    <th>Nom</th>
                    <td>{{ piece.name }}</td>
                </tr>
                <tr>
                    <th>Quantité</th>
                    <td>{{ piece.quantity }}</td>
                </tr>
                <tr>
                    <th>Seuil d'alerte</th>
                    <td>{{ piece.alertTreshold }}</td>
                </tr>
                <tr>
                    <th>Fournissseur</th>
                    <td>{{ piece.supplier }}</td>
                </tr>
            </tbody>
        </table>

        <div class="row">
            <div class=" m-2">
                <a href="{{ path('app_pieces_index') }}" class="btn btn-primary">Retour à la liste</a>
                <a class="btn btn-primary" href="{{ path('app_pieces_edit',  {'id': piece.id}) }}">Éditer</a>
                {{ include('pieces/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>

{% endblock %}