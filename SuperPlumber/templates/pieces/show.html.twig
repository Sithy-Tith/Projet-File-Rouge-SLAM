{% extends 'base.html.twig' %}

{% block title %}Pieces{% endblock %}

{% block body %}
    <h1>Pieces</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ piece.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ piece.name }}</td>
            </tr>
            <tr>
                <th>Quantity</th>
                <td>{{ piece.quantity }}</td>
            </tr>
            <tr>
                <th>AlertTreshold</th>
                <td>{{ piece.alertTreshold }}</td>
            </tr>
            <tr>
                <th>Supplier</th>
                <td>{{ piece.supplier }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_pieces_index') }}">back to list</a>

    <a href="{{ path('app_pieces_edit', {'id': piece.id}) }}">edit</a>

    {{ include('pieces/_delete_form.html.twig') }}
{% endblock %}
