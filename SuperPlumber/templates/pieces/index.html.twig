{% extends 'base.html.twig' %}

{% block title %}Pieces index{% endblock %}

{% block body %}
    <h1>Pieces index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Quantity</th>
                <th>AlertTreshold</th>
                <th>Supplier</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for piece in pieces %}
            <tr>
                <td>{{ piece.id }}</td>
                <td>{{ piece.name }}</td>
                <td>{{ piece.quantity }}</td>
                <td>{{ piece.alertTreshold }}</td>
                <td>{{ piece.supplier }}</td>
                <td>
                    <a href="{{ path('app_pieces_show', {'id': piece.id}) }}">show</a>
                    <a href="{{ path('app_pieces_edit', {'id': piece.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_pieces_new') }}">Create new</a>
{% endblock %}
