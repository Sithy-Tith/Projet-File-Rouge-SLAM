{% extends 'base.html.twig' %}

{% block title %}Inventaire des pièces{% endblock %}

{% block body %}
    <h1>Inventaire des pièces</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id (à enlever ?)</th>
                <th>Nom</th>
                <th>Fournisseur</th>
                <th>Quantité</th>
                <th>Seuil d'alerte</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        <!--    Affichage en top des pièces avec alerte de stock    -->
        {% for piece in alertePieces %}
            {% include "pieces/_rows.html.twig" with { piece: piece, alerte: true } %}
        {% endfor %}
        <!--    Affichage des autres pièces    -->
        {% for piece in normalPieces %}
            {% include "pieces/_rows.html.twig" with { piece: piece, alerte: false } %}
        {% endfor %}
        <t/body>
    </table>

    <a href="{{ path('app_pieces_new') }}">Nouvelle pièce</a>
{% endblock %}
