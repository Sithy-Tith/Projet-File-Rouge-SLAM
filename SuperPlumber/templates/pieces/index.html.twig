{% extends 'base.html.twig' %}

{% block title %}Inventaire des pièces{% endblock %}

{% block body %}
    <h1>Inventaire des pièces</h1>
    {% if edition  %}
        <a href="{{ path('app_pieces_inventory') }}">Quitter le mode édition</a>
    {% else %}
        <a href="{{ path('app_pieces_inventory',{edition : true}) }}">Activer mode édition</a>
    {% endif %}

    <!--    Début du tableau des pièces / formulaire   -->
    {% if edition %}
        <form method="post" action="{{path('app_pieces_inventory_form_submitted') }}">
    {% endif %}
    <table class="table">
        <thead>
            <tr>
                <th>Id (à enlever ?)</th>
                <th>Nom</th>
                <th>Fournisseur</th>
                <th>Quantité</th>
                <th {{edition ? '' : 'hidden'}}>Nouvelle quantité</th>
                <th>Seuil d'alerte</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

        <!--    Affichage en top des pièces avec alerte de stock    -->
        {% for piece in alertePieces %}
            {% include "pieces/_rows.html.twig" with { piece: piece, alerte: true, edition : edition } %}
        {% endfor %}

        <!--    Affichage des autres pièces    -->
        {% for piece in normalPieces %}
            {% include "pieces/_rows.html.twig" with { piece: piece, alerte: false, edition : edition } %}
        {% endfor %}
        <t/body>
    </table>
    {% if edition %}
        <button type="submit">Enregistrer</button>
        </form>
    {% endif %}

    <a href="{{ path('app_pieces_new') }}">Nouvelle pièce</a>
{% endblock %}
